{
  "name": "gridlook",
  "version": "1.10.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 5050",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "lint-ci": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "knip": "knip --dependencies --exports",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "!(*package-lock).json": [
      "prettier --write"
    ]
  },
  "type": "module",
  "dependencies": {
    "@earthyscience/netcdf4-wasm": "^0.4.0",
    "@eeholmes/zarrita-pcodec": "github:eeholmes/zarrita-pcodec",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@mapbox/vector-tile": "^2.0.5",
    "@tanstack/vue-virtual": "^3.13.52",
    "@vuepic/vue-datepicker": "14.0.0",
    "@vueuse/core": "^15.0.0",
    "@zarrita/storage": "^0.2.1",
    "axios": "^1.21.1",
    "bulma": "^1.0.4",
    "canvas-txt": "^4.1.1",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "codecita": "0.1.3",
    "d3-delaunay": "^6.0.6",
    "d3-geo": "^3.1.2",
    "d3-geo-projection": "^4.0.0",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "geokdbush": "2.1.0",
    "geotiff": "^3.0.5",
    "healpix-geo": "^0.3.3",
    "humanize-duration": "^3.35.1",
    "icechunk-js": "^0.7.1",
    "kdbush": "4.1.0",
    "pbf": "^4.0.2",
    "pinia": "^4.1.0",
    "proj4": "^2.23.0",
    "qrcode": "^1.5.4",
    "quick-lru": "^7.3.0",
    "three": "^0.187.0",
    "vue": "^3.5.46",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.5.1",
    "vue3-select-component": "^1.0.1",
    "zarrita": "^0.7.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.4",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "~24",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "6.46.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "sass": "~1.89.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-glsl": "^1.6.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}

{
  "name": "jupyterlab-gridlook",
  "version": "0.1.0",
  "description": "Open zarr stores from the JupyterLab file browser in the gridlook viewer",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "gridlook",
    "zarr"
  ],
  "homepage": "https://github.com/d70-t/gridlook",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*.{d.ts,js}",
    "style/**/*.{css,js,svg}"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "rimraf lib tsconfig.tsbuildinfo ../gridlook_jupyter/labextension",
    "test": "jest",
    "watch": "tsc -w --sourceMap"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.3"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "jupyterlab": {
    "extension": true,
    "outputDir": "../gridlook_jupyter/labextension"
  }
}
